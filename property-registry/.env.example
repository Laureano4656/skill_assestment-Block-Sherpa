# Polygon Amoy RPC URL (Default public RPC or Alchemy/Infura)
AMOY_RPC_URL=https://polygon-amoy.drpc.org

# Private key of the deployer wallet (without 0x prefix or with 0x prefix)
PRIVATE_KEY=your_private_key_here

# PolygonScan API Key for contract verification on Polygon Amoy
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here
